{
  "manifest_version": 3,
  "name": "Surface — Website Themes",
  "version": "0.2.0",
  "description": "Expressive, readable themes for ordinary websites.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Surface themes" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "css": ["preload.css"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }],
  "web_accessible_resources": [{
    "resources": [],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
